<!-- ============================================================
     SI-KOMPETENSI - V_Pengaturan.html (v5.0.0)
     Wrapper untuk komponen <app-settings> (dari app-modules.js CDN)
     ============================================================
     Komponen AppSettings sudah self-contained:
     - mounted() auto load get_config
     - CRUD: save_config_item, delete { entity:'KONFIGURASI', id:key }
     - Admin-only (dijaga menu adminOnly di J_App)
     ============================================================ -->

<section v-if="currentPage === 'pengaturan'" class="space-y-6">
  <app-settings v-if="isAdmin"></app-settings>

  <!-- Fallback jika user bukan admin (seharusnya tidak muncul karena menu adminOnly) -->
  <div v-else class="card p-8 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 text-center">
    <div class="w-16 h-16 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-3xl mx-auto mb-4">
      <i class="fa-solid fa-shield-halved"></i>
    </div>
    <h3 class="text-base font-bold text-slate-900 dark:text-white">Akses Terbatas</h3>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 max-w-sm mx-auto">
      Halaman Pengaturan hanya dapat diakses oleh Administrator. Hubungi admin SI-KOMPETENSI jika Anda memerlukan akses.
    </p>
  </div>
</section>
